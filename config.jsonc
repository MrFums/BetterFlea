// BetterFlea settings
// Lines that start with // are notes. The game does not read them.
// After you change a setting, restart the server.
// true = on. false = off.
// "Chance" values go from 0 (never) to 1 (always). For example, 0.6 means 60%.
// "Percent" values are percent. For example, 10 means 10%.
{
  // ==========================================================================
  //  FLEA - What players can buy on the Flea Market
  // ==========================================================================
  "flea": {
    // true = also use BSG's own list of banned items (for example M993 ammo).
    "enableBsgBlacklist": true,

    // true = remove this whole type of item from the Flea Market.
    // Each item is in only one of these groups.
    "bannedCategories": {
      "weapons": {
        "guns": false,
        "throwables": false,
        "melee": false            // knives, axes, hammers, crowbar and other melee weapons
      },
      "ammo": {
        "rounds": false,
        "ammoBoxes": false
      },
      "weaponParts": {
        "magazines": false,
        "sights": false,
        "suppressors": false,
        "otherParts": false            // all other weapon parts: barrels, stocks, grips and more
      },
      "gear": {
        "bodyArmor": false,
        "armoredRigs": false,          // rigs that have armor
        "chestRigs": false,            // rigs that have no armor
        "backpacks": false,
        "armorPlates": false,
        "headwear": false,
        "helmetAttachments": false,
        "faceCovers": false,
        "eyewear": false,
        "headphones": false,
        "armbands": false,
        "containers": false
      },
      "keys": {
        "mechanicalKeys": false,       // normal keys, not marked keys
        "markedKeys": false,
        "keycards": false
      },
      "medical": {
        "medkits": false,
        "bandagesAndSplints": false,
        "painkillers": false,
        "stimulants": false
      },
      "other": {
        "foodAndDrink": false,
        "barterItems": false,
        "info": false,
        "maps": false,
        "posters": false,
        "specialEquipment": false
      }
    },

    // Item IDs or category IDs. Example: ["5efb0c1bd79ff02a1f5e68d9"]
    "bannedItems": [],                 // these are never on the Flea Market
    "allowedItems": []                 // these are always on the Flea Market, even if banned above
  },

  // ==========================================================================
  //  GENERATED OFFERS - The offers the server makes (not offers from players)
  // ==========================================================================
  "generatedOffers": {

    // How many offers each item has. Normal SPT is 7 to 30 offers per item.
    "listings": {
      "multiplier": 2.0,               // 1 = normal. 2 = double. 0 = no offers (traders only). Highest: 10.
      "categoryMultipliers": {},       // use a different number for one group. Example: { "keys.markedKeys": 3.0 }
      "rarityMultipliers": {           // more offers for common items, fewer for rare items
        "Common": 1.5,
        "Rare": 1.0,
        "Superrare": 0.6
      }
    },

    // How many items are in one offer. Only for items that do not stack (ammo and money use normal SPT).
    //   max      = the most items in one offer
    //   falloff  = from 0 to 1. Lower = more offers with only 1 item.
    "itemsPerOffer": {
      "enabled": true,
      "armoredRigsSingle": true,                 // true = armored rigs always have 1 per offer
      "bulk": { "max": 20, "falloff": 0.85 },    // common small barter items: bulbs, wires, bolts
      "stock": { "max": 6, "falloff": 0.55 },    // rare small barter items, and common meds, food and weapon parts
      "few": { "max": 3, "falloff": 0.3 }        // very rare or big items, and all gear: GPU, LEDX, rigs
    },

    // Some offers have items that are partly used. The price is lower when less is left.
    "usedItems": {
      // Keys and keycards:
      //   usedChance          = chance that an offer is partly used. 0.6 = 60%.
      //   usesLeftFalloff     = from 0 to 1. Lower = more keys with only 1 use left.
      //   oneUsePricePercent  = price of a key with 1 use left, in % of a new key.
      "keys": {                        // normal keys, not marked keys
        "enabled": true,
        "usedChance": 0.6,
        "usesLeftFalloff": 0.75,
        "oneUsePricePercent": 20
      },
      "markedKeys": {
        "enabled": true,
        "usedChance": 0.6,
        "usesLeftFalloff": 0.8,
        "oneUsePricePercent": 20
      },
      "keycards": {
        "enabled": true,
        "usedChance": 0.5,
        "usesLeftFalloff": 0.7,
        "oneUsePricePercent": 20
      },

      // Meds, food, fuel and repair kits:
      //   usedChance     = chance that an offer is partly used.
      //   lowAmountBias  = 1 means any amount left. Higher = more offers that are almost empty.
      "meds": {
        "enabled": true,
        "usedChance": 0.5,
        "lowAmountBias": 2.5
      },
      "foodAndDrink": {
        "enabled": true,
        "usedChance": 0.4,
        "lowAmountBias": 2.0
      },
      "fuel": {
        "enabled": true,
        "usedChance": 0.6,
        "lowAmountBias": 2.5
      },
      "repairKits": {
        "enabled": true,
        "usedChance": 0.4,
        "lowAmountBias": 2.0
      }
    }
  },

  // ==========================================================================
  //  PRICES - The prices of the offers the server makes
  // ==========================================================================
  "prices": {
    // Price of the 7 marked keys on the Flea Market. 1 = normal. 1.5 = 50% more.
    // Trader prices do not change.
    "markedKeyMultiplier": 1.0,

    // An offer is never cheaper than the most a trader pays for the item.
    // This stops players buying on the Flea Market and selling to a trader for profit.
    "floor": {
      "enabled": true,
      "marginPercent": 10,             // the cheapest offer is this % more than the trader price
      "logTraderProfitLoops": false    // true = at start, write in the server log the items that one trader sells for less than another trader pays
    },

    // Prices go up and down a little over time. Only new offers get the new price.
    "drift": {
      "enabled": true,
      "maxDriftPercent": 10,           // the most a price can change from normal, up or down
      "stepPercent": 2,                // the most a price can change in one step
      "updateMinutes": 45              // about how often a price can change
    }
  },

  // ==========================================================================
  //  PLAYER SELLING - Players selling their own items
  // ==========================================================================
  "playerSelling": {
    "enabled": true,                   // false = players cannot sell on the Flea Market
    "foundInRaidOnly": false,          // true = players can only sell items that are found in raid (like live Tarkov)

    // Players wait some time before the first buyer comes.
    "saleDelay": {
      "enabled": true,
      "minMinutes": 2,                 // shortest wait
      "maxMinutes": 20,                // longest wait
      "noDelayChance": 0.1             // chance of no wait. 0.1 = 10%.
    },

    // A player who buys many of one item, then sells it on the Flea Market, waits longer for a buyer.
    // This only works when saleDelay is on. When the server restarts, it forgets old purchases.
    "flipPenalty": {
      "enabled": true,
      "windowMinutes": 60,             // purchases older than this do not count
      "freePurchases": 2,              // a player can buy this many of one item with no extra wait
      "purchasesForMaxPenalty": 10,    // at this many purchases, the extra wait is the longest
      "maxExtraMinutes": 90,           // the longest extra wait, in minutes
      "countFleaPurchases": true,      // true = purchases from the Flea Market also count, not only from traders
      "fenceMultiplier": 3             // 1 item bought from Fence counts as this many
    },

    // true = items bought from a trader (also Fence) can never be sold on the Flea Market.
    // Players can still use them, or sell them to a trader.
    // Parts on a bought gun are also locked.
    // Ammo, ammo boxes and other items that stack are not locked.
    "purchaseLock": {
      "enabled": true
    }
  },

  // ==========================================================================
  //  DEBUG
  // ==========================================================================
  // true = write a lot of extra lines in the server log. Use this only to test.
  "debugLogging": false
}
