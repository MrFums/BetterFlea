<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>BetterFlea</RootNamespace>
        <AssemblyName>BetterFlea</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <!-- Don't put this PC's folder path into the built DLL. -->
        <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SPTarkov.Common" Version="4.1.0" />
        <PackageReference Include="SPTarkov.DI" Version="4.1.0" />
        <PackageReference Include="SPTarkov.Reflection" Version="4.1.0" />
        <PackageReference Include="SPTarkov.Server.Core" Version="4.1.0" />
        <!-- Only for the settings page link in the launcher's Mod Pages. -->
        <PackageReference Include="SPTarkov.Server.Web" Version="4.1.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- The game-side plugin is its own project. -->
        <Compile Remove="Client\**" />
        <None Remove="Client\**" />
        <Content Remove="Client\**" />
        <!-- Local notes, not part of the mod. -->
        <Compile Remove="_References\**" />
        <None Remove="_References\**" />
        <Content Remove="_References\**" />
    </ItemGroup>

    <ItemGroup>
        <None Update="configs\*.jsonc" CopyToOutputDirectory="PreserveNewest" />
        <!-- A copy of each settings file inside the DLL, written back out if a user deletes one. -->
        <EmbeddedResource Include="configs\*.jsonc" LogicalName="BetterFlea.configs.%(Filename)%(Extension)" />
        <!-- The settings page at /betterflea. -->
        <EmbeddedResource Include="Web\index.html;Web\icon.png;CHANGELOG.md" LogicalName="BetterFlea.web.%(Filename)%(Extension)" />
        <!-- How real flea prices moved through a wipe, per item (Wipe Cycle). -->
        <EmbeddedResource Include="Prices\wipe-curves.json" LogicalName="BetterFlea.data.wipe-curves.json" />
        <!-- Better Flea's own fixed price for every base-game item (Research/tools/price_index.py). -->
        <EmbeddedResource Include="Prices\price-index.json" LogicalName="BetterFlea.data.price-index.json" />
        <!-- The level each item can be bought from on the real flea (tarkov.dev's minLevelForFlea). -->
        <EmbeddedResource Include="Flea\flea-levels.json" LogicalName="BetterFlea.data.flea-levels.json" />
    </ItemGroup>

    <PropertyGroup>
        <ModOutputDir>$(ServerDir)\user\mods\$(AssemblyName)</ModOutputDir>
        <Version>2.4.0-beta.2</Version>
    </PropertyGroup>

    <!-- Only with -p:ServerDir="C:\path\to\SPT\SPT_Runtime": copies the mod into that server. Without it, it just builds. -->
    <Target Name="DeployToServer" AfterTargets="AfterBuild" Condition=" '$(ServerDir)' != '' ">
        <!-- Always update the dll, but never overwrite a settings file the user has edited. -->
        <ItemGroup>
            <ConfigFiles Include="configs\*.jsonc" />
        </ItemGroup>
        <MakeDir Directories="$(ModOutputDir);$(ModOutputDir)\configs"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputDir)" />
        <Copy SourceFiles="@(ConfigFiles)" DestinationFolder="$(ModOutputDir)\configs"
              Condition="!Exists('$(ModOutputDir)\configs\%(ConfigFiles.Filename)%(ConfigFiles.Extension)')" />
    </Target>
</Project>
