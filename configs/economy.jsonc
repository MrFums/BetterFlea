// BetterFlea - ECONOMY: Better Flea's own prices, real flea prices, and prices that follow the wipe
// Please change these on the settings page (https://127.0.0.1:6969/betterflea), not in this file. Better Flea pricing is
// on by default; live prices and the Wipe Cycle are off.
// Delete this file and restart the server to get the default settings back.
{
  // Uses Better Flea's own fixed price for every base-game item as its base price, in place of SPT's. Built from
  // real PvP and PvE flea prices and trader prices; it doesn't move. The rest of BetterFlea's pricing goes on top.
  // While it's on, live prices aren't used.
  "betterFleaPricing": {
    "enabled": true,
    "estimateModdedItems": true,     // modded items get a price on the same scale, from similar base-game items
    "contentBackport": true,         // the base-game items WTT ContentBackport adds get Better Flea's price too
    "liveTraderPrices": true         // traders pay what they do live (Therapist 51% of base price, SPT 63%). A trader another mod changed (SVM) keeps that mod's
  },

  // Uses the real flea's 24 hour average price (from tarkov.dev) as every item's base price. The rest of
  // BetterFlea's pricing goes on top. The prices are saved, so if tarkov.dev is down the last ones are used.
  "livePrices": {
    "enabled": false,
    "gameMode": "live",              // "live" (PvP), "pve" or "season"
    "refreshHours": 24,              // fetch new prices this long after the last fetch (by the clock, restarts don't matter)
    "estimateModdedItems": true      // modded items get a price on the same scale, from similar base-game items.
                                     // Real-game items added by mods (content backports) aren't counted as modded.
  },

  // EXPERIMENTAL. Prices follow how far into the wipe the players online are, shaped by how real flea prices
  // moved through a wipe. Early on everything is scarce and hideout and quest items are dear; late on the best
  // guns, ammo, armour and stims are dear and early-wipe items are cheap.
  "wipeCycle": {
    "enabled": false,
    "strength": 1.0,                 // size of the swings. 0.5 = half, 2 = double
    "levelStep": 3,                  // prices move every this many levels
    "cooldownMinutes": 30,           // after the flea's level changes, it stays put this long
    "endLevel": 60,                  // about the level where a wipe "ends"
    "prestige": "add",               // a prestiged player: "add" = counts as late wipe, "reset" = a fresh wipe
    "level": 0                       // for testing: pretend the players are this level. 0 = highest level online
  }
}
