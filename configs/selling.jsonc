// BetterFlea - SELLING: players selling their own items on the Flea Market
// Please change these on the settings page (https://127.0.0.1:6969/betterflea), not in this file.
// true = on. false = off. Delete this file and restart the server to get the default settings back.
{
  "enabled": true,                   // false = players cannot sell on the Flea Market
  "foundInRaidOnly": false,          // true = players can only sell items that are found in raid
  "notifications": true,             // false = no pop-ups or Messenger messages about the flip penalty, or about a trader item that can't be listed

  // How fast a player's offer sells depends on its price against the normal price.
  // Cheaper than normal: sells in under a minute. At the normal price: minMinutes to maxMinutes. Dearer: whether it
  // sells at all is decided once, by the roubles over: against an allowance of 0.8 x expensivePercent of the normal
  // price plus overpriceRoubles. Up to half the allowance over it always sells, at the whole allowance half the time,
  // from one and a half times it never; the further over, the longer it takes. The normal price goes by what's in
  // the item: its parts, plates and their condition, and where the market has the item right now.
  "saleDelay": {
    "enabled": true,
    "minMinutes": 2,                 // only with buyers off: shortest wait for a plain item at the normal price
    "maxMinutes": 8,                 // only with buyers off: longest wait for a plain item at the normal price
    "noDelayChance": 0.1,            // only with buyers off: chance of no wait at all for a plain item at or under the normal price. 0.1 = 10%
    "uniqueMinMinutes": 1,           // a gun, armour or anything with durability at the normal price usually waits this long at 20,000 roubles or less, times the square root of how many times dearer (dear plain items like a GPU too)
    "uniqueMaxMinutes": 60,          // ...but usually never longer than this. About 2.3 minutes at 110,000, 9 for a LEDX, 30 for a marked key
    "rareWaitMultiplier": 1.25,      // a rare item (the game's rarity) waits this many times as long at the normal price
    "superrareWaitMultiplier": 1.5,  // and a superrare one this many times
    "slowSaleMaxHours": 4,           // only with buyers off: a pile priced over normal that does sell finds its buyer any time up to this many hours later
    "expensivePercent": 15,          // 0.8 x this share of the normal price (12%) is part of the allowance over normal. An item you bought lately never sells past this much over
    "neverSellsPercent": 100,        // safety cap: this much over the normal price (100 = twice it), nothing sells. At the defaults nothing sells past 78% over anyway
    "overpriceRoubles": 8000,        // the rest of the allowance over normal, in roubles, so a few thousand over on a cheap item hardly matters...
    "overpriceRoublesMaxPercent": 40, // ...but never more than this share of the normal price
    "overpriceDearShrink": 0.2,      // over 100,000 roubles the 12% shrinks by (100,000 / normal)^this: 8% on a LEDX, 5% on a marked key. 0 = off
    "overpriceDearSlowdown": 0.4,    // over 100,000 roubles the wait over normal is (normal / 100,000)^this times as long: twice on a LEDX, 6 times on a marked key. 0 = off
    "overpriceWaitMinutes": 30,      // usual extra wait at the whole room over normal (where it sells half the time); x^1.5 times this, x = how many rooms over
    "dearFromRoubles": 100000,       // from this normal price an item counts as dear (overpriceDearShrink, overpriceDearSlowdown)
    "gearOverpricePercent": 20,      // room over normal for gear (guns, armour, helmets, rigs with plates, anything with durability or parts in it), in % of its normal price; single items get 0.8 x expensivePercent
    "gearDearFromRoubles": 300000,   // gear dearer than this gets less of that room (overpriceDearShrink)
    "classicOverpricing": false,     // true = 2.5.1's percent rule in place of the room above. Not recommended: only for anyone who preferred how 2.5.1 felt
    "wreckedWaitMultiplier": 3,      // wrecked armour or a wrecked helmet waits this many times as long for its buyer
    "cheaperWaitMultiplier": 2       // one thing with durability on its own (glasses, a bare helmet, a plate) that another seller has cheaper waits this many times as long
  },

  // Buyers go down the list. For the item you have open and every item a player has listed (one item per offer, not
  // packs), a buyer turns up every 15 seconds to a minute and takes the cheapest single offer, if the price is one people pay
  // (see saleDelay.expensivePercent). Your offer sells when the buyers get to it, so cheaper offers go first. Each
  // buyer takes what people buy at once: one or two of most things, a round lot of ammo (30, 60, 120, 180, 200 or the lot).
  // After each sale buyers come less often, so a pile of one item sells a bit at a time. An offer someone buys is
  // replaced by a new seller a while later, not straight away.
  "buyers": {
    "enabled": true,
    "minMinutes": 0.05,              // shortest wait for the next buyer, for an item of about 20,000 roubles. Dearer, rarer and less wanted items wait longer
    "maxMinutes": 0.2,               // longest wait
    "slowdown": 1.1,                 // after each sale from a player's offer the wait is this many times longer (3 times at most)...
    "recoverMinutes": 10,            // ...and half of that wears off in this long
    "wholeOfferChance": 0.08,        // chance a buyer takes another seller's whole offer, not just a few. Offers of 3 or fewer always go whole
    "relistMinMinutes": 1,           // a bought offer is replaced this long later (random between)
    "relistMaxMinutes": 5,
    "rarityMultipliers": {           // buyers take this many times longer for a rare item than a common one. 1 = no longer
      "Common": 1.0,
      "Rare": 1.5,
      "Superrare": 3.0
    }
  },

  // Set sale times. On, these replace everything above that decides how fast an offer sells (buyers, other sellers'
  // offers, undercuts): a player's offer sells after a wait, in minutes, between the shortest and longest for its
  // rarity. 0 and 0 = sells straight away. The flip penalty still adds its wait. The waits below are about what an
  // item at the normal price takes with this off (guns and armour take longer: saleDelay.uniqueMinMinutes).
  "saleTime": {
    "enabled": false,
    "ignorePrice": false,            // true = sells whatever its price. false = over normal it sells less often and later, past saleDelay.neverSellsPercent never
    "commonMinMinutes": 0,
    "commonMaxMinutes": 1,
    "rareMinMinutes": 1,
    "rareMaxMinutes": 3,
    "superrareMinMinutes": 3,
    "superrareMaxMinutes": 8
  },

  // When players get the Flea Market, how many offers they can have up, and how fast their flea rep grows. Offer slots
  // go up with flea rep (SPT: 4 at the start, rep 0.2; 5 from rep 7; up to 15 from 1000), so the slots are changed
  // for every rep step. Players see a new unlock level or slot count after logging in again. Left at these defaults,
  // SPT's values (or another mod's) are kept.
  "fleaAccess": {
    "unlockLevel": 15,               // level the Flea Market opens at (SPT: 15)
    "repGainMultiplier": 1,          // flea rep from each sale x this (2 = twice as fast). SPT: +0.02 per 100,000 roubles sold
    "extraOfferSlots": 0,            // added to each rep step's offer slots, after the multiplier. Never under 1 slot
    "offerSlotsMultiplier": 1        // each rep step's offer slots x this (2 = twice as many)
  },

  // Other sellers watch the market. A player's offer that's the cheapest one up gets, now and then, another seller
  // listing just under it (a rouble under, or a round number under) a few minutes later, who takes most of its
  // buyers. The dearer the offer, the likelier. One well under the normal price sells before anyone bothers.
  // Guns, armour and anything with durability are never undercut: buyers judge each on its own price.
  "undercut": {
    "enabled": true,
    "chanceAtNormal": 0.35,          // chance for an offer at the normal price
    "chanceWhenDear": 0.8,           // chance for one at saleDelay.expensivePercent over
    "safeBelowPercent": 10,          // this far under normal: hardly ever undercut (1%)
    "minMinutes": 1,                 // how long after listing it happens
    "maxMinutes": 10,
    "buyersLeft": 0.15               // share of the offer's buyers who still buy it afterwards
  },

  // A player who buys many of one item, then sells it on the Flea Market, waits longer for a buyer.
  // Only the items bought wait, not ones of the same kind the player already had. Items that stack (ammo) go by type.
  // Also, while this is on, anything bought in the last 48 hours (a part in it too, like one plate) never sells more than
  // expensivePercent over normal. Off by default.
  // This only works when saleDelay is on. Recent purchases are saved in data\recent-purchases.json, so a restart doesn't wipe them.
  "flipPenalty": {
    "enabled": false,
    "windowMinutes": 30,             // purchases older than this do not count
    "freePurchases": 2,              // a player can buy this many of one item with no extra wait
    "purchasesForMaxPenalty": 10,    // at this many purchases, the extra wait is the longest
    "maxExtraMinutes": 10,           // the longest extra wait, in minutes. Enough to put flipping off, not to stall a sale
    "countFleaPurchases": true,      // true = purchases from the Flea Market also count, not only from traders
    "fenceMultiplier": 3             // 1 item bought from Fence counts as this many
  },

  // true = items bought from a trader (also Fence) can never be sold on the Flea Market.
  // Players can still use them, or sell them to a trader.
  // Parts on a bought gun are also locked.
  // Ammo, ammo boxes and other items that stack are not locked.
  // Purchases are remembered even while this is off, so turning it on also locks what was bought before.
  // An item is forgotten once the player no longer has it.
  "purchaseLock": {
    "enabled": false,
    "includeFleaPurchases": false  // true = items bought from other players on the flea are locked too, not only from traders
  }
}
