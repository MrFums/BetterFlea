// BetterFlea - FLEA: what players can buy on the Flea Market
// Please change these on the settings page (https://127.0.0.1:6969/betterflea), not in this file.
// true = on. false = off. Delete this file and restart the server to get the default settings back.
{
  // true = also use BSG's own list of banned items (for example M993 ammo).
  "enableBsgBlacklist": true,

  // true = remove this whole type of item from the Flea Market.
  // Each item is in only one of these groups.
  "bannedCategories": {
    "weapons": {
      "guns": false,
      "throwables": false,
      "melee": false            // knives, axes, hammers, crowbar and other melee weapons
    },
    "ammo": {
      "rounds": false,
      "ammoBoxes": false
    },
    "weaponParts": {
      "magazines": false,
      "sights": false,
      "suppressors": false,
      "otherParts": false            // all other weapon parts: barrels, stocks, grips and more
    },
    "gear": {
      "bodyArmor": false,
      "armoredRigs": false,          // rigs that have armor
      "chestRigs": false,            // rigs that have no armor
      "backpacks": false,
      "armorPlates": false,
      "headwear": false,
      "helmetAttachments": false,
      "faceCovers": false,
      "eyewear": false,
      "headphones": false,
      "armbands": false,
      "containers": false
    },
    "keys": {
      "mechanicalKeys": false,       // normal keys, not marked keys
      "markedKeys": false,
      "keycards": false
    },
    "medical": {
      "medkits": false,
      "bandagesAndSplints": false,
      "painkillers": false,
      "stimulants": false
    },
    "other": {
      "foodAndDrink": false,
      "barterItems": false,
      "info": false,
      "maps": false,
      "posters": false,
      "specialEquipment": false
    }
  },

  // Item IDs or category IDs. Example: ["5efb0c1bd79ff02a1f5e68d9"]
  "bannedItems": [],                 // these are never on the Flea Market
  "allowedItems": [],                // these are always on the Flea Market, even if banned above

  // Items added by other server mods, by mod name. ["all"] bans everything the mod adds, or list the types
  // to ban from it, named as above. Example: { "Some Mod": ["weapons.guns", "gear.backpacks"] }
  // Easiest to set on the settings page, which lists the mods that add items.
  "bannedModItems": {},

  // Like the real flea: some items can only be bought and sold from a certain level (the M4A1 from 25, a
  // graphics card from 30). Uses the real game's levels, updated from tarkov.dev when live prices are on.
  "levelLock": {
    "enabled": true,
    "selling": true,                 // locked items can't be listed for sale either, like live
    "moddedItems": true              // modded items unlock with the base-game items of their kind worth about the same
  }
}
